# ── Runtime ────────────────────────────────────────────────────────────────
# "production" enables single-origin serving of client/dist and hides error details.
NODE_ENV="development"

# What this process runs: both (one process, two ports) | honeypot | dashboard.
# A PaaS gives one port per service, so deploy two services (SERVICE=honeypot and
# SERVICE=dashboard); each then listens on the platform-provided PORT.
SERVICE="both"

# Honeypot = the public fake site. API = the internal dashboard (API + built UI).
HONEYPOT_PORT=8080
HONEYPOT_HOST="0.0.0.0"
API_PORT=3000
API_HOST="127.0.0.1"          # keep on loopback; use 0.0.0.0 only inside a container

# Optional HTTP Basic auth for the dashboard. Set BOTH to enable it.
# Required if the dashboard port is reachable from anywhere but localhost.
# DASHBOARD_USER="admin"
# DASHBOARD_PASSWORD="change-me"

# ── Supabase Postgres (Prisma) ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# ── AI provider (pre-trained model only, nothing is trained) ───────────────
LLM_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"     # alternative: qwen/qwen3.6-27b
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# LLM_TIMEOUT_MS=180000
